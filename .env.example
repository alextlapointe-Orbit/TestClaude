# TMM - Traffic Management Module - Environment Variables
# Copy this file to backend/.env and fill in your values

# Database (PostgreSQL on Render, or SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./tmm.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/tmm_db

# Security - generate a strong random secret for production
SECRET_KEY=change-me-to-a-long-random-string-in-production

# AIS Stream (get free API key at https://aisstream.io)
AISSTREAM_API_KEY=your-aisstream-api-key-here

# Mapbox (get free token at https://account.mapbox.com)
MAPBOX_TOKEN=your-mapbox-public-token-here

# App settings
DEBUG=false
